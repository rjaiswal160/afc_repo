@model ContactModel
@{
    ViewData["Title"] = "Afc contact";
}
<style>
    .title-color{
        color: #1b69b4;
        font-weight:bold;
    }
    .text-bold{
     font-weight:bold;
    }

    .fl-heading {
        font-weight: 500;
        font-size: 26px;
    }

    
</style>
<h2 class="title-color"> <span class="fl-heading-text">Contact AFC Industries For Tailored Ergonomic Solutions</span></h2>
<div class="fl-rich-text"><p>At <a href="https://afcindustries.com/">AFC Industries</a>, we are dedicated to providing you with top-tier ergonomic solutions that enhance your workspace. Whether you're looking for ergonomic workstations, custom-designed furniture, or specialized accessories, our team is here to assist you. If you have any inquiries or need personalized recommendations, don't hesitate to contact <a href="https://afcindustriespa.com/" target="_blank" rel="noopener">AFC Industries</a>. We value your feedback and are committed to helping you create a comfortable and efficient workspace that meets your unique requirements. Reach out to us today, and let's work together to transform your workspace into an ergonomic haven. Your satisfaction is our priority, and we're just a click or call away. Contact AFC Industries now to embark on your journey to improved workspace comfort and productivity.</p></div>

@using (Html.BeginForm("Contact", "Home", FormMethod.Post))
{
    <div class="row">
        <div class="col-6">
            <h1 class="fl-heading"> <span class="fl-heading-text">Contact Us</span></h1>
            <h2 class="fl-heading"> <span class="fl-heading-text">Send us message here</span></h2>
    <div>
        @Html.LabelFor(m => m.FirstName, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "First Name" })
        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
    </div>

    <div>
                @Html.LabelFor(m => m.LastName, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Last Name" })
        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
    </div>

    <div>
                @Html.LabelFor(m => m.Email, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <div>
                @Html.LabelFor(m => m.Phone, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Phone" })
        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
    </div>

    <div>
                @Html.LabelFor(m => m.Ext, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.Ext, new { @class = "form-control", placeholder = "Ext (optional)" })
        @Html.ValidationMessageFor(m => m.Ext, "", new { @class = "text-danger" })
    </div>

    <div>
                @Html.LabelFor(m => m.CompanyName, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control", placeholder = "Company Name" })
        @Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "text-danger" })
    </div>

    <div>
                @Html.LabelFor(m => m.Website, new { @class = "text-bold" })
        @Html.TextBoxFor(m => m.Website, new { @class = "form-control", placeholder = "Website" })
        @Html.ValidationMessageFor(m => m.Website, "", new { @class = "text-danger" })
    </div>


    <div>
                @Html.LabelFor(m => m.Subject, new { @class = "text-bold" })
