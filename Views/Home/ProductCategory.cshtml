<div id="woopack-t4y2i1hawv95" class="woopack-products-grid-wrap woocommerce">
    <ul class="woopack-products products" style="position: relative; height: 1718.86px;">
        <h1>@Model.FirstOrDefault()?.CategoryName</h1>
        <ul class="tile-grid">
            @foreach (var config in Model)
            {
                <li class="tile">
                    <div class="tile-image">
                        <a href="~/product/@config.SEO_Slug" title="@config.Name">
                            <img src="@config.ImageUrl" alt="@config.Name" class="product-image" />
                        </a>
                    </div>
                    <div class="tile-content">
                        <h3 class="tile-title">
                            <a href="~/product/@config.SEO_Slug" title="@config.Name">@config.Name</a>
                        </h3>
                        <div class="tile-meta">
                            <span class="sku">SKU: @config.SKU</span>
                        </div>
                    </div>
                </li>
            }
        </ul>

    </ul>
</div>
