@model List<Configurator>
<h1>@ViewData["Title"]</h1>
<link href="~/css/autoptimize_single.css" rel="stylesheet" />
<link href="~/css/autoptimize_single_1.css" rel="stylesheet" />
<style>

</style>
<h2>Horizontal Configurator</h2>
<p>Let’s Start Your Build. Please choose a size, shape and color.</p>
<div class="row">
    <div class="col">
    </div>
    <div class="col" style="height: 100vh; overflow-y: scroll;">
        <div class="accordion" id="accordionItems">
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-7">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-7" aria-expanded="true" aria-controls="collapse-7">Track</button>
                </h2>
                <div id="collapse-7" class="accordion-collapse collapse show" aria-labelledby="heading-7">
                    <div class="accordion-body">
                        <div class="row">
                            @foreach (var config in Model.Where(con => con.ProductType == "track"))
                            {
                                <div class="item @(Model.IndexOf(config) == 0 ? "selected" : "")">
                                    <div class="image">
                                        <img decoding="async" src="@config.ImageUrl" alt="@config.ProductName" />
                                    </div>
                                    <p class="title">@config.ProductName</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-7">
