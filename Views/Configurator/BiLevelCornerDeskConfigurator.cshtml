@model List<Configurator>
<h1>@ViewData["Title"]</h1>
<link href="~/css/autoptimize_single.css" rel="stylesheet" />
<link href="~/css/autoptimize_single_1.css" rel="stylesheet" />
<style>

</style>
<h2>Bi-Level Tier Corner Desk Configurator</h2>
<p>Let’s Start Your Build. Please choose a size, shape and color.</p>
<div class="row">
    <div class="col">
    </div>
    <div class="col" style="height: 100vh; overflow-y: scroll;">
        <div class="accordion" id="accordionItems">
            <div class="accordion-item">
                <h2 class="" id="heading-00"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-00" aria-expanded="true" aria-controls="collapse-00">Size</button></h2>
                <div id="collapse-00" class="accordion-collapse collapse show" aria-labelledby="heading-00" style="">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="item size selected">
                                <div class="image hide"><img decoding="async" src="https://afcindustries.com/wp-content/plugins/prod/products/72X36 Single Tier Configurator/Surface Size Thumbnails.png" /></div>
                                <p class="title">48"</p>
                            </div>
                            <div class="item size">
                                <div class="image hide"><img decoding="async" src="https://afcindustries.com/wp-content/plugins/prod/products/72X36 Single Tier Configurator/Surface Size Thumbnails.png" /></div>
                                <p class="title">60"</p>
                            </div>
                            <div class="item size">
                                <div class="image hide"><img decoding="async" src="https://afcindustries.com/wp-content/plugins/prod/products/72X36 Single Tier Configurator/Surface Size Thumbnails.png" /></div>
                                <p class="title">72"</p>
                            </div>
                            <div class="item size">
                                <div class="image hide"><img decoding="async" src="https://afcindustries.com/wp-content/plugins/prod/products/72X36 Single Tier Configurator/Surface Size Thumbnails.png" /></div>
                                <p class="title">84"</p>
                            </div>
                            <div class="item size">
                                <div class="image hide"><img decoding="async" src="https://afcindustries.com/wp-content/plugins/prod/products/72X36 Single Tier Configurator/Surface Size Thumbnails.png" /></div>
                                <p class="title">95"</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-color">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-color" aria-expanded="true" aria-controls="collapse-color">Color</button>
                </h2>
                <div id="collapse-color" class="accordion-collapse collapse show" aria-labelledby="heading-color">
                    <div class="accordion-body">
                        <div class="row">
                            @foreach (var config in Model.Where(con => con.ProductType == "color"))
                            {
                                <div class="item @(Model.IndexOf(config) == 0 ? "selected" : "")">
                                    <div class="image">
                                        <img decoding="async" src="@config.ImageUrl" alt="@config.ProductName" />
                                    </div>
                                    <p class="title">@config.ProductName</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-2">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-2" aria-expanded="true" aria-controls="collapse-2">Desktop Surface</button>
