                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-7">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-7" aria-expanded="true" aria-controls="collapse-7">Monitor Arm</button>
