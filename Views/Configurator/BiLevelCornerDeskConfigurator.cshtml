                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-0">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-0" aria-expanded="true" aria-controls="collapse-0">Accessories</button>
                </h2>
                <div id="collapse-0" class="accordion-collapse collapse show" aria-labelledby="heading-0">
                    <div class="accordion-body">
                        <div class="row">
